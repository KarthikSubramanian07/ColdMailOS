# 
#  Local-only env - used by the one-time helper scripts in /scripts.
#  Copy to `.env` and fill in. This file is NOT read by the deployed Worker
#  (the Worker reads secrets set via `wrangler secret put`).
# 

# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client
# Used by `npm run gmail:auth` to mint your Gmail refresh token.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Optional: override the local OAuth callback port (default 5173).
OAUTH_PORT=5173
