{
  "name": "coldmailos",
  "version": "0.1.0",
  "description": "Open-source pipeline that extracts contacts from any list of pages — labs, VC portfolios, anywhere — syncs to Notion, and drafts personalized cold outreach emails with AI. Runs entirely on free infrastructure.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "cloudflare-workers",
    "notion",
    "groq",
    "gmail",
    "cold-email",
    "outreach",
    "research",
    "startups",
    "scraping",
    "llm"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:research": "wrangler deploy --env research",
    "deploy:startups": "wrangler deploy --env startups",
    "typecheck": "tsc --noEmit",
    "tail": "wrangler tail --format pretty",
    "config:push": "node scripts/push-config.mjs",
    "gmail:auth": "node scripts/get-gmail-token.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "typescript": "^5.6.2",
    "wrangler": "^3.78.0"
  }
}
