{
  "name": "researchmailos",
  "version": "0.1.0",
  "description": "Point it at any list of lab/department/faculty pages, get structured researchers + research focus out, and turn a Notion checkbox into a personalized Gmail draft. Runs entirely on free infrastructure.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "cloudflare-workers",
    "notion",
    "groq",
    "gmail",
    "research",
    "cold-email",
    "outreach",
    "scraping",
    "llm"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "tail": "wrangler tail --format pretty",
    "scrape:now": "wrangler dev --test-scheduled",
    "config:push": "node scripts/push-config.mjs",
    "gmail:auth": "node scripts/get-gmail-token.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "typescript": "^5.6.2",
    "wrangler": "^3.78.0"
  }
}
