{
  "name": "coldmailos",
  "version": "0.1.0",
  "description": "Open-source pipeline that finds researchers from any lab/startup page, syncs to Notion, and drafts personalized cold emails for research or internship outreach.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "cloudflare-workers",
    "notion",
    "groq",
    "gmail",
    "cold-email",
    "outreach",
    "research",
    "startups",
    "scraping",
    "llm"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:research": "wrangler deploy --env research",
    "deploy:startups": "wrangler deploy --env startups",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "tail": "wrangler tail --format pretty",
    "config:push": "node scripts/push-config.mjs",
    "gmail:auth": "node scripts/get-gmail-token.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261029.1",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.9",
    "wrangler": "^4.114.0"
  },
  "dependencies": {
    "robots-parser": "^3.0.1",
    "zod": "^4.4.3"
  }
}
